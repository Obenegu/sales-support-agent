# Environment Variables for Sales & Support AI Agent
# Copy this file to .env and fill in your actual values

# Database URLs (use 'db' as host for Docker Compose, 'localhost' for local dev)
DATABASE_URL=postgresql://tabot:hello@db:5432/agent_memory
ASYNC_DATABASE_URL=postgresql+asyncpg://tabot:hello@db:5432/agent_memory

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
MEM0_API_KEY=your_mem0_api_key_here

# Optional: OpenRouter / other providers
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
